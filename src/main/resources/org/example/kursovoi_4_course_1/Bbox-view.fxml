<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.kursovoi_4_course_1.Controllers.BboxController"
            prefWidth="1120.0"
            prefHeight="720.0"
            minWidth="1120.0"
            minHeight="720.0"
            style="-fx-background-color: #efefef;">

    <children>

        <!-- Логотип -->
        <ImageView fx:id="logoImageView"
                   fitWidth="150.0"
                   fitHeight="70.0"
                   preserveRatio="true"
                   smooth="true"
                   pickOnBounds="true"
                   AnchorPane.leftAnchor="30.0"
                   AnchorPane.topAnchor="24.0" />

        <!-- Блок логина -->
        <HBox alignment="CENTER_RIGHT"
              spacing="8.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.topAnchor="30.0">
            <children>
                <Label text="Логин"
                       style="-fx-font-size: 14px; -fx-text-fill: #222222; -fx-font-weight: 600;" />

                <StackPane prefWidth="36.0"
                           prefHeight="36.0"
                           style="-fx-background-color: #222222; -fx-background-radius: 18;">
                    <children>
                        <Label text="&#x1F464;"
                               style="-fx-text-fill: white; -fx-font-size: 14px;" />
                    </children>
                </StackPane>
            </children>
        </HBox>

        <!-- Центральная область -->
        <HBox alignment="CENTER"
              spacing="10.0"
              AnchorPane.topAnchor="90.0"
              AnchorPane.leftAnchor="38.0"
              AnchorPane.rightAnchor="86.0"
              AnchorPane.bottomAnchor="78.0">

            <children>

                <!-- Камера -->
                <StackPane fx:id="cameraContainer"
                           prefWidth="360.0"
                           prefHeight="360.0"
                           minWidth="360.0"
                           minHeight="360.0"
                           maxWidth="360.0"
                           maxHeight="360.0"
                           style="-fx-border-color: #111111;
                                  -fx-border-width: 3;
                                  -fx-border-radius: 8;
                                  -fx-background-color: white;
                                  -fx-background-radius: 6;">

                    <children>
                        <AnchorPane fx:id="cameraPane"
                                    prefWidth="340.0"
                                    prefHeight="340.0"
                                    minWidth="340.0"
                                    minHeight="340.0"
                                    maxWidth="340.0"
                                    maxHeight="340.0"
                                    style="-fx-background-color: white;" />
                    </children>
                </StackPane>

                <!-- Правая панель геометрии -->
                <VBox fx:id="geometryPanel"
                      prefWidth="300.0"
                      prefHeight="360.0"
                      minWidth="300.0"
                      minHeight="360.0"
                      maxWidth="300.0"
                      maxHeight="360.0"
                      spacing="12.0"
                      alignment="TOP_LEFT"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-border-color: #111111;
                             -fx-border-width: 3;
                             -fx-border-radius: 8;
                             -fx-padding: 18;">

                    <children>
                        <Label text="Геометрия лица"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #111111;" />

                        <Separator />

                        <GridPane hgap="10.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="58.0" />
                                <ColumnConstraints percentWidth="42.0" />
                            </columnConstraints>

                            <children>
                                <Label text="Межзрач. расст.:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="iodValue" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Нос–Подбородок:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="noseChinValue" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Ширина рта:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="mouthWValue" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Ширина лица:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="faceWValue" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Высота лица:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="faceHValue" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Пропорция В/Ш:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="hwValue" text="-" GridPane.rowIndex="5" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Глаза/Нос (IOD):" GridPane.rowIndex="6" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="eyeNoseValue" text="-" GridPane.rowIndex="6" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />

                                <Label text="Симметрия:" GridPane.rowIndex="7" GridPane.columnIndex="0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #333333;" />
                                <Label fx:id="symmetryValue" text="-" GridPane.rowIndex="7" GridPane.columnIndex="1"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1f78d1;" />
                            </children>
                        </GridPane>

                        <Region VBox.vgrow="ALWAYS" />

                        <Label text="Данные обновляются в реальном времени."
                               wrapText="true"
                               prefWidth="260.0"
                               maxWidth="260.0"
                               style="-fx-font-size: 12px; -fx-text-fill: #777777;" />
                    </children>
                </VBox>

            </children>
        </HBox>

        <!-- Нижняя информация о моделях -->
        <VBox spacing="6.0"
              alignment="BOTTOM_LEFT"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.bottomAnchor="30.0">
            <children>
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Модель:"
                               style="-fx-font-size: 12px; -fx-text-fill: #222222; -fx-font-weight: 600;" />
                        <Label fx:id="model1Value"
                               text="bbox"
                               style="-fx-font-size: 12px; -fx-text-fill: #111111;" />
                    </children>
                </HBox>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Модель:"
                               style="-fx-font-size: 12px; -fx-text-fill: #222222; -fx-font-weight: 600;" />
                        <Label fx:id="model2Value"
                               text="points"
                               style="-fx-font-size: 12px; -fx-text-fill: #111111;" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Выдвижная панель -->
        <AnchorPane fx:id="sideDrawer"
                    AnchorPane.topAnchor="70.0"
                    AnchorPane.rightAnchor="-110.0"
                    prefWidth="180.0"
                    prefHeight="160.0"
                    style="-fx-background-color: transparent;">

            <children>
                <VBox alignment="TOP_LEFT"
                      spacing="8.0"
                      prefWidth="180.0"
                      prefHeight="160.0">
                    <children>
                        <Button fx:id="toggleButton"
                                text="←"
                                mnemonicParsing="false"
                                onAction="#handleToggleDrawer"
                                prefWidth="44.0"
                                prefHeight="44.0"
                                style="-fx-background-color: #1f78d1;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-font-size: 18px;" />

                        <Button fx:id="adminButton"
                                text="Войти как администратор"
                                mnemonicParsing="false"
                                onAction="#handleAdminLogin"
                                visible="false"
                                opacity="0"
                                wrapText="true"
                                prefWidth="160.0"
                                prefHeight="40.0"
                                style="-fx-background-color: #1f78d1;
                                       -fx-text-fill: white;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8;" />

                        <Button fx:id="logoutButton"
                                text="Выйти"
                                mnemonicParsing="false"
                                onAction="#handleLogout"
                                visible="false"
                                opacity="0"
                                prefWidth="160.0"
                                prefHeight="36.0"
                                style="-fx-background-color: #ff6a00;
                                       -fx-text-fill: white;
                                       -fx-font-weight: 600;
                                       -fx-background-radius: 8;" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>

    </children>
</AnchorPane>